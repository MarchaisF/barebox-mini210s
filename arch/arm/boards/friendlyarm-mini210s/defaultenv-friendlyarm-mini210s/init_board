#!/bin/sh

if [ -e /dev/nand0 ]; then
	addpart /dev/nand0 "5M@0x600000(kernel)"
	if [ $? != 0 ]; then
		echo "Could not create the NAND kernel partition"
	else
		nand -a /dev/nand0.kernel
		if [ $? != 0 ]; then
			echo "Could not create /dev/nand0.kernel.bb"
		fi
	fi
fi

nand_parts="256k@0xc0000(misc),5M(recovery),5M(kernel),3M(ramdisk),-(system)"